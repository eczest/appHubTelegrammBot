# Токен бота из @BotFather
BOT_TOKEN=1234567890:PASTE_NEW_BOTFATHER_TOKEN_HERE
# Закрытая группа, куда бот отправляет заявки клиентов
MANAGER_CHAT_ID=-1000000000000

# Канал с прайсами и главным меню
CHANNEL_ID=-1003976893957

# Ссылка на канал для кнопки "Посмотреть цены".
# Если оставить пустой, бот соберет ссылку вида https://t.me/c/... из CHANNEL_ID.
CHANNEL_URL=

# Telegram ID пользователей, которым разрешены команды управления меню.
# Несколько значений указываются через запятую.
ADMIN_USER_IDS=123456789

TIMEZONE=Asia/Yekaterinburg
LOG_LEVEL=INFO
